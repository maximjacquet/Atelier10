<!-- views/pages/index.ejs -->

<!DOCTYPE html>

<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body class="container">

    <header>
        <%- include('../partials/header') %>

    </header>

    <main>

        <div class="jumbotron">

            <h1>Atelier 10</h1>
            <p id="connection-message">Connexion au serveur...</p>
            <p id="launch-time">Heure de lancement : en attente...</p>
            <p id="refresh-time">Dernier rafraîchissement : en attente...</p>

        </div>

    </main>



    <footer>

        <%- include('../partials/footer') %>

    </footer>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const refreshTime = new Date().toLocaleString('fr-FR');
        document.getElementById('refresh-time').textContent = 'Dernier rafraîchissement : ' + refreshTime;

        socket.on('message', function (message) {
            document.getElementById('connection-message').textContent = message;
        });
        socket.on('launch-time', function (launchTime) {
            document.getElementById('launch-time').textContent = 'Heure de lancement : ' + launchTime;
        });
    </script>
</body>

</html>